{
  "name": "securenv",
  "version": "0.0.0",
  "description": "Secure environment based on libsodium",
  "license": "Apache-2.0",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:node && npm run test:bare",
    "schema": "node schema.js",
    "test:node": "node test.js",
    "test:bare": "bare test.js"
  },
  "dependencies": {
    "b4a": "^1.9.0",
    "bare-fs": "^4.8.4",
    "bare-path": "^3.1.3",
    "bare-process": "^4.5.1",
    "bare-subprocess": "^6.2.2",
    "bare-tty": "^5.2.2",
    "hyperschema": "^1.26.2",
    "paparam": "^1.15.0",
    "sodium-native": "^5.2.1"
  },
  "devDependencies": {
    "brittle": "^4.5.0"
  },
  "files": [
    "index.js",
    "bin.js",
    "lib",
    "spec"
  ],
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    },
    "child_process": {
      "bare": "bare-subprocess",
      "default": "child_process"
    },
    "tty": {
      "bare": "bare-tty",
      "default": "tty"
    }
  },
  "bin": {
    "securenv": "bin.js"
  }
}
